{
  "name": "@ztward/sdk",
  "version": "0.1.1",
  "type": "module",
  "description": "JavaScript SDK for Ztward platform with browser and Node.js support",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./nodejs": {
      "types": "./dist/nodejs/index.d.ts",
      "import": "./src/nodejs/index.js"
    },
    "./generated/*": {
      "types": "./src/generated/*.d.ts",
      "import": "./src/generated/*.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.js",
    "proto",
    "!proto/**/*.go",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "npm run proto:gen && rollup -c && npm run patch:types",
    "proto:gen": "protoc --plugin=protoc-gen-es=node_modules/.bin/protoc-gen-es --plugin=protoc-gen-connect-es=node_modules/.bin/protoc-gen-connect-es --es_out=src/generated --es_opt=target=js+dts --connect-es_out=src/generated --connect-es_opt=target=js+dts --proto_path=proto proto/services/key-access/key-access.proto proto/services/key-manager/key-manager.proto proto/services/platform/platform.proto proto/models/ztdf.proto proto/models/stanag4774.proto",
    "patch:types": "node scripts/patch-types.js",
    "test": "node --test",
    "lint": "eslint .",
    "docs": "jsdoc -c jsdoc.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ztward",
    "zero-trust",
    "encryption",
    "access-control",
    "ztdf",
    "abac",
    "policy"
  ],
  "author": "Ztward",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bdparrish/ztward.git",
    "directory": "sdk/js"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.0",
    "@connectrpc/connect": "^1.7.0",
    "@connectrpc/connect-web": "^1.7.0",
    "axios": "^1.6.0",
    "jose": "^5.2.0",
    "jszip": "^3.10.1",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "optionalDependencies": {
    "@connectrpc/connect-node": "^1.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@bufbuild/protoc-gen-es": "^1.10.0",
    "@connectrpc/protoc-gen-connect-es": "^1.7.0",
    "@eslint/js": "^9.39.5",
    "@rollup/plugin-babel": "^6.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.2.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "jsdoc": "^4.0.0",
    "rollup": "^4.6.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}

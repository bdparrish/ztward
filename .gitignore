!pap-ui/.env.docker
*.bak
scripts/cross-sdk.env
scripts/.keycloak-tokens*.json
.keycloak-tokens*.json
*.p12
*.pfx
*.jks

# Local dev TLS material: generated by `make certs`, the private keys must not be published
config/examples/certs/

# Generated client keys and test outputs
artifacts/

# --- Infrastructure state (contains account details) ---
*.tfstate
*.tfstate.*
**/.terraform/
.terraform.lock.hcl
deployment/aws/old

# --- Build output ---
bin/
dist/
build/
**/java/build/
**/.gradle/
node_modules/
**/.gocache
*.test
**/coverage.out
**/pprof/*

# Compiled Go binaries built inside go/ (build into ./bin instead)
/go/bin/
/go/pap-server
/go/platform-server
/go/ztdf-client
/go/cmd/ztdf-client/ztdf-client

# Python
**/__pycache__/
*.pyc
sdk/python/.venv*/
sdk/python/.ruff_cache/
sdk/python/.mypy_cache/
sdk/python/.pytest_cache/
*.egg-info/

# --- Editor / OS ---
.idea/
.vscode/
**/.DS_Store

# --- Local tool output ---
graphify-out/
output.html
.port-scratch/
.readme-check/
.initcheck/

# Leftover generated key from a past load-test run (nothing references it)
load-testing/k6/client-keys/

# Compiled sample binary
samples/web/yubikey/yubikey

# Environment-specific Helm overlay with real endpoint/credentials (see values-rds.example.yaml)
deployment/helm/ztward/values-rds.yaml

# Internal working notes (not product docs; kept on disk, excluded from the public repo)
docs/misc/
docs/CUSTOMER_DISTRIBUTION.md

# Coverage/profile output and stray test artifacts in go/
/go/*.out
/go/file.txt.ztdf

# Scraped third-party documentation used as local AI context (not ours to redistribute)
opentdf_context.md

# MkDocs build output (published by the docs workflow)
/site/

# Copy this file to scripts/cross-sdk.env (or another location) and fill in the values

# Core service endpoints
# gRPC host:port, plus https:// URIs so every SDK uses TLS
ZTWARD_KEY_ACCESS_URL=localhost:50053
ZTWARD_KEY_ACCESS_URI=https://localhost:50053
ZTWARD_KEY_MANAGER_URL=localhost:50052
ZTWARD_KEY_MANAGER_URI=https://localhost:50052
ZTWARD_KEYCLOAK_URL=http://localhost:8080
ZTWARD_KEYCLOAK_REALM=ztward

# Local dev CA used by every SDK to verify the TLS services (relative paths resolve from the repo root)
ZTWARD_GRPC_CA_FILE=config/examples/certs/ca.crt

# Optional pre-fetched bearer token. Leave unset to have the runner fetch a fresh
# one from Keycloak with ZTWARD_USERNAME/ZTWARD_PASSWORD (tokens expire in minutes).
# ZTWARD_BEARER_TOKEN=

# OIDC client ID (required by every SDK tool; must exist in the realm)
ZTWARD_CLIENT_ID=ztward-ztdf-client

# Credentials used to fetch the token (local dev realm test user)
# ZTWARD_CLIENT_SECRET=replace-me
ZTWARD_USERNAME=user123
ZTWARD_PASSWORD=password123

# Optional subject override (useful when relying on client credentials tokens without a `sub` claim)
# ZTWARD_SUBJECT_ID=service-account-id

# Policy to embed in every ZTDF (base64-encoded JSON)
ZTWARD_POLICY_

# Resource attributes asserted during wrap/unwrap (key=value pairs, comma separated)
ZTWARD_RESOURCE_ATTRIBUTES=classification=confidential,http://example.com/attr/classification/value/confidential=true

# Optional overrides
# ZTWARD_RESOURCE=my-resource
# ZTWARD_FILENAME=interop.txt
# ZTWARD_CONTENT_TYPE=text/plain
# ZTWARD_GO_KEY_DIR=/absolute/path/to/go/client/keys
# ZTWARD_JS_KEY_DIR=/absolute/path/to/js/client/keys
# ZTWARD_JAVA_KEY_DIR=/absolute/path/to/java/client/keys

# Ztward PAP Web UI configuration for local development (copy to .env).
# This is a browser app: never put client secrets here.

# PAP API (TLS; your browser must trust the dev CA from `make certs`)
VITE_PAP_API_URL=https://localhost:8090

# Keycloak (public client, redirects to http://localhost:3000)
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=ztward
VITE_KEYCLOAK_CLIENT_ID=ztward-pap-ui

# Build-time configuration for the Docker image (`npm run build -- --mode docker`).
# The API URL is relative because nginx in the image proxies /api/ to the PAP service.
# This is a browser app: never put client secrets here.
VITE_PAP_API_URL=/api
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=ztward
VITE_KEYCLOAK_CLIENT_ID=ztward-pap-ui
